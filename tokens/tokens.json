{
  "name": "Photonics Design System",
  "version": "0.1.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "unit": "px",
    "emuPerPx": 9525,
    "ptPerPx": 0.75
  },
  "color": {
    "white": { "value": "#FFFFFF", "use": "Slide ground, boxes on panels" },
    "ink": { "value": "#171B1F", "use": "Titles and body text" },
    "slate": { "value": "#515A61", "use": "Notes, quotes, secondary text" },
    "stone": { "value": "#B5B4B4", "use": "Footer band" },
    "mist": { "value": "#D7D9DA", "use": "Hairlines and table rules" },
    "panel": { "value": "#F3F4F4", "use": "Panels and table headers" },
    "red": { "value": "#DF3621", "use": "Title rule, step circles, panel edges" },
    "brick": { "value": "#AC2818", "use": "Links, citations, eyebrows, task labels" },
    "hot": { "value": "#EE0033", "use": "Page tab only" }
  },
  "font": {
    "sans": {
      "family": "FS PF BeauSans Pro",
      "fallback": ["Fira Sans", "Arial", "sans-serif"]
    },
    "numeral": {
      "family": "FS Magistral",
      "fallback": ["Exo 2", "Arial", "sans-serif"]
    }
  },
  "type": {
    "cover": { "font": "sans", "size": 64, "lineHeight": 90, "weight": 700, "tracking": -1.28 },
    "title": { "font": "sans", "size": 60, "lineHeight": 84, "weight": 700, "tracking": -1.2 },
    "stat": { "font": "sans", "size": 54, "lineHeight": 76, "weight": 700, "tracking": -0.8 },
    "quote": { "font": "sans", "size": 42.7, "lineHeight": 56, "weight": 400, "tracking": 0 },
    "stepNumeral": { "font": "numeral", "size": 40, "lineHeight": 56, "weight": 700, "style": "italic", "tracking": 0 },
    "heading": { "font": "sans", "size": 38, "lineHeight": 53, "weight": 700, "tracking": -0.37 },
    "stepTitle": { "font": "sans", "size": 38, "lineHeight": 53, "weight": 400, "tracking": -0.37 },
    "pageNumber": { "font": "sans", "size": 30, "lineHeight": 42, "weight": 700, "tracking": 0 },
    "body": { "font": "sans", "size": 30, "lineHeight": 45, "weight": 400, "tracking": 0 },
    "caption": { "font": "sans", "size": 24, "lineHeight": 36, "weight": 400, "tracking": 0 },
    "tableHeader": { "font": "sans", "size": 24, "lineHeight": 36, "weight": 700, "tracking": 0.48 },
    "eyebrow": { "font": "sans", "size": 24, "lineHeight": 34, "weight": 700, "tracking": 1.92, "transform": "uppercase" }
  },
  "layout": {
    "margin": 48,
    "title": { "x": 48, "y": 25, "height": 84 },
    "titleRule": { "x": 48, "y": 117, "width": 288, "height": 12, "color": "red" },
    "contentTop": 181,
    "noteTop": 889,
    "leftColumn": { "x": 48, "right": 650 },
    "rightColumn": { "x": 728, "right": 1856 },
    "footer": {
      "band": { "x": 0, "y": 1032, "width": 1920, "height": 48, "color": "stone" },
      "tab": { "x": 1656, "y": 1032, "width": 264, "height": 48, "color": "hot" }
    }
  },
  "component": {
    "stepCircle": { "size": 80, "color": "red" },
    "calloutEdge": { "height": 8, "color": "red" },
    "hairline": { "width": 2, "color": "mist" },
    "tableCellPadding": 24
  }
}
